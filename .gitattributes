* text=auto

*.php text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.bat text eol=crlf
# The template people copy to scripts\filehost-env.bat; cmd.exe needs CRLF there as well.
*.bat.example text eol=crlf

# Files that end up inside containers, on servers or in hash-locked installs keep their bytes
# identical on every checkout.
Dockerfile text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.neon text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
.htaccess text eol=lf
.env.example text eol=lf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.phar binary
