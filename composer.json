{
    "name": "tryhackx/tryhackx-files",
    "description": "TryHackX Files - a fast, self-hosted file sharing application",
    "type": "project",
    "license": "PolyForm-Noncommercial-1.0.0",
    "homepage": "https://github.com/TryHackX/TryHackX-Files",
    "authors": [
        {
            "name": "TryHackX",
            "homepage": "https://github.com/TryHackX"
        }
    ],
    "support": {
        "issues": "https://github.com/TryHackX/TryHackX-Files/issues",
        "source": "https://github.com/TryHackX/TryHackX-Files"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.8"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=1G"
    }
}
