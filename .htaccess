# Safety net for a development checkout (WAMP and similar) that sits under the default
# localhost document root. The real virtual host's DocumentRoot is public/, so Apache never
# applies this file to it; here everything EXCEPT public/ is blocked, which keeps src/, config/
# (config.local.php), data/, uploads/ and the Python server unreachable at
# http://localhost/<project>/* while public/ stays reachable at http://localhost/<project>/public/.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|config|data|uploads|scripts|venv|docs|__pycache__)/ - [F,L]
</IfModule>

<FilesMatch "\.(py|pyc|md|lock|service|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files "config.local.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</Files>
