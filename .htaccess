# Read only when this project directory sits inside a web server's document root — typically
# a local development setup reached as http://localhost/<project>/public/. Production and the
# Docker image point DocumentRoot at public/ itself, so Apache never consults this file there
# (docs/DEBIAN.md, docker/apache-vhost.conf).
#
# Everything outside public/ is refused: source, config/config.local.php, data/, uploads/,
# tests/, tools/, vendor/, docs/, the Python server and .git/. Listing the forbidden directories
# one by one (as this file used to) silently missed whatever was added later.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule !^public(?:/|$) - [F,L]
</IfModule>

# Fallback for a server without mod_rewrite, and a second line for files that must never be
# served even from public/.
<FilesMatch "(?:^\.|\.(?:py|pyc|md|lock|service|bat|sh|neon|sql|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files "config.local.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</Files>
