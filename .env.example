# Copy to .env and change every password before the first `docker compose up -d`.
# Docker Compose passes the values below to the app; the installer writes the durable local
# configuration on first run.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=filehost
MYSQL_USER=filehost
MYSQL_PASSWORD=change-me

# Host port for the app (container always listens on 80 internally).
HTTP_PORT=8080

# Public origin used for redirects, assets and every security-sensitive e-mail link.
# It must match the scheme, host and port used by browsers.
FILEHOST_CANONICAL_URL=http://localhost:8080

# Generate a unique value, for example: openssl rand -hex 32
# Placeholder/short values are rejected; remove this value after a successful installation.
FILEHOST_INSTALL_TOKEN=replace-with-at-least-32-random-characters

# Direct peer addresses allowed to open the installer. This Docker-only example covers the
# default private bridge ranges; use an exact address or a narrower CIDR where possible.
FILEHOST_INSTALL_ALLOW_IPS=172.16.0.0/12

# Resource caps for untrusted image/video thumbnail parsing.
FILEHOST_THUMB_WORKERS=2
FILEHOST_THUMB_MAX_INPUT_BYTES=268435456
FILEHOST_THUMB_MAX_SOURCE_PIXELS=40000000

# Lease for interrupted-download recovery. Keep 120 in production; CI temporarily uses 5.
FILEHOST_DOWNLOAD_LEASE_SECONDS=120

# Set to 1 to disable HTTP access logs and routine worker output. Warnings and errors remain.
FILEHOST_MINIMAL_LOGS=0

# Where the "Local mail server" e-mail method submits. Only needed when the MTA is not on this
# host's port 25 — for example a relay container on the same Compose network.
# FILEHOST_LOCAL_MTA=127.0.0.1:25

# Test harness only. Leave both values unchanged outside isolated CI.
FILEHOST_CI_SMOKE=0
FILEHOST_CI_PREBODY_DELAY_MS=0
