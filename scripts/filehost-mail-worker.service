# TryHackX Files - durable e-mail outbox worker (template for install-debian.sh)
#
# The worker must never hand mail to a setgid helper. NoNewPrivileges below strips the setgid
# bit from Postfix's postdrop, which then warns about an unwritable maildrop and sleeps ten
# seconds in a loop with no end - PHP mail() never returns and the queue silently stops.
# Set Settings -> E-mail to the local mail server (SMTP on 127.0.0.1:25) or to an external
# SMTP server; both submit over a socket and need no privilege transition.
[Unit]
Description=TryHackX Files E-mail Outbox Worker
After=network.target mysql.service mariadb.service postfix.service
# The worker exits when the database is unreachable or the schema is mid-migration. A start
# limit turned a minute of database downtime into a unit that stayed "failed" until someone ran
# `systemctl reset-failed`, and the queue silently stopped. Keep retrying instead; the journal
# rate limit below bounds the noise of a long outage.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-/etc/default/filehost
ExecStart=/usr/bin/php __APP_DIR__/scripts/mail-worker.php --loop --limit=25 --sleep=5
Restart=always
RestartSec=10

# A blocked transport used to leave the process "active (running)" while it delivered nothing.
# The worker reports liveness between messages, so a stuck delivery is restarted, not endured.
NotifyAccess=main
WatchdogSec=120

# One misbehaving helper filled a journal with 3.4 GB of identical warnings. Cap the unit.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

# Resource limits
LimitNOFILE=4096
TasksMax=64
MemoryMax=512M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# "full", not "strict": the relaxed mode of scripts/mail-worker-hardening.sh lets PHP mail() reach
# the setgid postdrop helper, which writes to /var/spool/postfix/maildrop.
ProtectSystem=full
# install-debian.sh switches this to read-only when the application lives under /home or /root.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX carries the database socket and the watchdog datagrams, AF_NETLINK is what glibc
# resolves host names with.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=__APP_DIR__/data
UMask=0027

[Install]
WantedBy=multi-user.target
