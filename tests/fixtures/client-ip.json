{
  "_about": "Shared by tests/php/SidecarClientIpContractTest.php and tests/python/test_upload_server.py. PHP's src/includes/ClientIp.php is the source of truth; upload_server.py must answer every case alike, because PHP binds tokens to the resolved address and both sides count clients by the throttle key. Cases marked php_only cannot occur behind the Apache hop (Apache always appends the peer it saw).",
  "throttle_keys": [
    ["203.0.113.9", "203.0.113.9"],
    ["2001:db8:1:2:aaaa:bbbb:cccc:dddd", "2001:db8:1:2::/64"],
    ["2001:db8:1:2::1", "2001:db8:1:2::/64"],
    ["2001:db8:1:2:ffff::ffff", "2001:db8:1:2::/64"],
    ["2001:db8:1:3::1", "2001:db8:1:3::/64"],
    ["::ffff:192.0.2.5", "192.0.2.5"],
    ["::ffff:0:0", "0.0.0.0"],
    ["ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff", "ffff:ffff:ffff:ffff::/64"],
    ["2001:DB8:0:0:1::1", "2001:db8::/64"],
    ["2001:0db8:0001:0002:0003:0004:0005:0006", "2001:db8:1:2::/64"],
    ["2001:db8:0:1:2:3:4:5", "2001:db8:0:1::/64"],
    ["0:0:0:1234::5", "0:0:0:1234::/64"],
    ["1:0:0:0:0:0:0:1", "1::/64"],
    ["::1", "::/64"],
    ["::192.0.2.5", "::/64"],
    ["64:ff9b::192.0.2.33", "64:ff9b::/64"],
    ["fe80::1%eth0", "fe80::1%eth0"],
    ["2001:db8::/64", "2001:db8::/64"],
    [" 203.0.113.9", " 203.0.113.9"],
    ["unknown", "unknown"],
    ["", ""]
  ],
  "resolve": [
    {
      "case": "without configured proxies only the peer counts",
      "server": {"REMOTE_ADDR": "198.51.100.20", "HTTP_X_FORWARDED_FOR": "1.2.3.4", "HTTP_CF_CONNECTING_IP": "5.6.7.8", "HTTP_X_REAL_IP": "9.9.9.9"},
      "trusted": [], "header": "", "expected": "198.51.100.20"
    },
    {
      "case": "headers from a peer that is not a configured proxy are ignored",
      "server": {"REMOTE_ADDR": "198.51.100.20", "HTTP_X_FORWARDED_FOR": "1.2.3.4", "HTTP_CF_CONNECTING_IP": "5.6.7.8", "HTTP_X_REAL_IP": "9.9.9.9"},
      "trusted": ["10.0.0.1"], "header": "", "expected": "198.51.100.20"
    },
    {
      "case": "X-Forwarded-For is read from the right, skipping our own proxies",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "1.2.3.4, 203.0.113.50, 10.0.0.2"},
      "trusted": ["10.0.0.1", "10.0.0.2"], "header": "", "expected": "203.0.113.50"
    },
    {
      "case": "a client-supplied CF-Connecting-IP is not believed unless the operator says so",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "1.2.3.4, 203.0.113.50, 10.0.0.2", "HTTP_CF_CONNECTING_IP": "5.6.7.8"},
      "trusted": ["10.0.0.1", "10.0.0.2"], "header": "", "expected": "203.0.113.50"
    },
    {
      "case": "garbage in the proxy part falls back to the peer",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "203.0.113.50, not-an-address"},
      "trusted": ["10.0.0.1"], "header": "", "expected": "10.0.0.1"
    },
    {
      "case": "an explicitly named single-value header is used",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "1.2.3.4", "HTTP_CF_CONNECTING_IP": "203.0.113.77"},
      "trusted": ["10.0.0.1"], "header": "CF-Connecting-IP", "expected": "203.0.113.77"
    },
    {
      "case": "an invalid value in the named header falls back to the peer",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "1.2.3.4", "HTTP_CF_CONNECTING_IP": "junk"},
      "trusted": ["10.0.0.1"], "header": "CF-Connecting-IP", "expected": "10.0.0.1"
    },
    {
      "case": "an unknown header name is never believed",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "1.2.3.4", "HTTP_CF_CONNECTING_IP": "203.0.113.77"},
      "trusted": ["10.0.0.1"], "header": "X-Unknown", "expected": "10.0.0.1"
    },
    {
      "case": "Docker behind Traefik or Caddy, configured as docs/DOCKER.md says",
      "server": {"REMOTE_ADDR": "172.18.0.5", "HTTP_X_FORWARDED_FOR": "198.51.100.7"},
      "trusted": ["172.18.0.5"], "header": "", "expected": "198.51.100.7"
    },
    {
      "case": "behind Cloudflare with TRUSTED_PROXY_HEADER",
      "server": {"REMOTE_ADDR": "172.18.0.5", "HTTP_X_FORWARDED_FOR": "198.51.100.7", "HTTP_CF_CONNECTING_IP": "198.51.100.8"},
      "trusted": ["172.18.0.5"], "header": "cf-connecting-ip", "expected": "198.51.100.8"
    },
    {
      "case": "X-Real-IP named with stray spaces, IPv6 value",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_REAL_IP": " 2001:db8::7 "},
      "trusted": ["10.0.0.1"], "header": " X-Real-IP ", "expected": "2001:db8::7"
    },
    {
      "case": "configured proxies are trimmed and empty entries ignored",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "203.0.113.5"},
      "trusted": [" 10.0.0.1 ", ""], "header": "", "expected": "203.0.113.5"
    },
    {
      "case": "a chain of nothing but our own proxies falls back to the peer",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "10.0.0.2, 10.0.0.1"},
      "trusted": ["10.0.0.1", "10.0.0.2"], "header": "", "expected": "10.0.0.1"
    },
    {
      "case": "empty entries in X-Forwarded-For are skipped",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": " , 203.0.113.5, "},
      "trusted": ["10.0.0.1"], "header": "", "expected": "203.0.113.5"
    },
    {
      "case": "an address with leading zeros is garbage",
      "server": {"REMOTE_ADDR": "10.0.0.1", "HTTP_X_FORWARDED_FOR": "01.2.3.4"},
      "trusted": ["10.0.0.1"], "header": "", "expected": "10.0.0.1"
    },
    {
      "case": "IPv6 client behind an IPv6 proxy",
      "server": {"REMOTE_ADDR": "2001:db8::1", "HTTP_X_FORWARDED_FOR": "2001:db8:5::9"},
      "trusted": ["2001:db8::1"], "header": "", "expected": "2001:db8:5::9"
    },
    {
      "case": "configured proxies are compared as written, not as addresses",
      "server": {"REMOTE_ADDR": "2001:db8::1", "HTTP_X_FORWARDED_FOR": "2001:db8:5::9"},
      "trusted": ["2001:0db8::1"], "header": "", "expected": "2001:db8::1"
    },
    {
      "case": "no peer at all",
      "server": {"REMOTE_ADDR": ""},
      "trusted": ["10.0.0.1"], "header": "", "expected": "unknown", "php_only": true
    }
  ]
}
